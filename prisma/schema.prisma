// SignalDesk Pro — Prisma Schema
// Multi-tenant SaaS: every business table scoped by organizationId

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth & Identity ──────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  notifications Notification[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Organization & Membership ────────────────────────────────────────────────

enum MemberRole {
  OWNER
  ADMIN
  MANAGER
  CLIENT
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      Membership[]
  clients          Client[]
  projects         Project[]
  revisionRequests RevisionRequest[]
  activityLogs     ActivityLog[]
  notifications    Notification[]
  onboardingDrafts OnboardingDraft[]
  subscription     Subscription?

  @@map("organizations")
}

model Membership {
  id             String     @id @default(cuid())
  userId         String
  organizationId String
  role           MemberRole @default(CLIENT)
  invitedEmail   String?
  inviteAccepted Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

// ─── Clients ──────────────────────────────────────────────────────────────────

enum ClientStatus {
  ACTIVE
  ONBOARDING
  PAUSED
  CHURNED
}

model Client {
  id              String       @id @default(cuid())
  organizationId  String
  name            String
  email           String
  company         String
  industry        String
  phone           String?
  website         String?
  notes           String?      @db.Text
  status          ClientStatus @default(ONBOARDING)
  accountManagerId String?
  totalRevenue    Decimal      @default(0) @db.Decimal(12, 2)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects     Project[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("clients")
}

// ─── Projects ─────────────────────────────────────────────────────────────────

enum ProjectStatus {
  INTAKE
  IN_PROGRESS
  REVIEW
  DELIVERED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Project {
  id             String          @id @default(cuid())
  organizationId String
  clientId       String
  name           String
  description    String?         @db.Text
  status         ProjectStatus   @default(INTAKE)
  priority       ProjectPriority @default(MEDIUM)
  startDate      DateTime?
  dueDate        DateTime?
  completedDate  DateTime?
  budget         Decimal?        @db.Decimal(12, 2)
  spent          Decimal         @default(0) @db.Decimal(12, 2)
  progress       Int             @default(0)
  tags           String[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  members          ProjectMember[]
  revisionRequests RevisionRequest[]
  activityLogs     ActivityLog[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([clientId])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("contributor")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

// ─── Revisions ────────────────────────────────────────────────────────────────

enum RevisionStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

model RevisionRequest {
  id             String         @id @default(cuid())
  organizationId String
  projectId      String
  title          String
  description    String?        @db.Text
  status         RevisionStatus @default(PENDING)
  version        Int            @default(1)
  submittedBy    String
  reviewedBy     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages     RevisionMessage[]

  @@index([organizationId])
  @@index([projectId])
  @@map("revision_requests")
}

model RevisionMessage {
  id                String   @id @default(cuid())
  revisionRequestId String
  authorId          String
  authorName        String
  authorRole        String
  content           String   @db.Text
  createdAt         DateTime @default(now())

  revisionRequest RevisionRequest @relation(fields: [revisionRequestId], references: [id], onDelete: Cascade)

  @@index([revisionRequestId])
  @@map("revision_messages")
}

// ─── Activity & Audit ─────────────────────────────────────────────────────────

enum ActivityAction {
  CLIENT_CREATED
  CLIENT_UPDATED
  CLIENT_ARCHIVED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_STATUS_CHANGED
  REVISION_SUBMITTED
  REVISION_APPROVED
  REVISION_REJECTED
  REVISION_CHANGES_REQUESTED
  MEMBER_INVITED
  MEMBER_REMOVED
  SETTINGS_UPDATED
  SUBSCRIPTION_CHANGED
}

model ActivityLog {
  id             String         @id @default(cuid())
  organizationId String
  projectId      String?
  actorId        String
  actorName      String
  action         ActivityAction
  description    String
  metadata       Json?
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, projectId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ─── Notifications ────────────────────────────────────────────────────────────

enum NotificationType {
  INVITE
  REVISION_UPDATE
  APPROVAL
  REJECTION
  PROJECT_UPDATE
  SYSTEM
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  type           NotificationType
  title          String
  body           String
  href           String?
  read           Boolean          @default(false)
  emailSent      Boolean          @default(false)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([organizationId])
  @@map("notifications")
}

// ─── Onboarding Draft ─────────────────────────────────────────────────────────

model OnboardingDraft {
  id             String   @id @default(cuid())
  organizationId String
  createdById    String
  currentStep    Int      @default(0)
  data           Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("onboarding_drafts")
}

// ─── Billing ──────────────────────────────────────────────────────────────────

enum SubscriptionPlan {
  STARTER
  GROWTH
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  plan                 SubscriptionPlan   @default(STARTER)
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}
